# Copy to .env and fill in. Never commit .env.
PORT=3000

# AI provider: gemini | openai   (openai = any OpenAI-compatible chat completions API)
AI_PROVIDER=gemini

# Gemini (free key: https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-request AI timeout (ms)
AI_TIMEOUT_MS=45000

# Rate limiting (per IP)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Optional hardening: comma-separated extension IDs allowed to call this server.
# Leave empty during development. Find the ID at chrome://extensions.
ALLOWED_EXTENSION_IDS=
# Optional: extra allowed web origins (comma-separated), e.g. for a hosted dashboard
ALLOWED_ORIGINS=
